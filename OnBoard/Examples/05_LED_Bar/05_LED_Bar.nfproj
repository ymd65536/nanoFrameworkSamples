<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <NanoFrameworkProjectSystemPath>$(MSBuildExtensionsPath)\nanoFramework\v1.0\</NanoFrameworkProjectSystemPath>
    <NanoFrameworkLocalPath>$(MSBuildProjectDirectory)\build\nanoFramework\v1.0\</NanoFrameworkLocalPath>
  </PropertyGroup>

  <Import Project="$(NanoFrameworkLocalPath)NFProjectSystem.Default.props" Condition="Exists('$(NanoFrameworkLocalPath)NFProjectSystem.Default.props')" />
  <Import Project="$(NanoFrameworkProjectSystemPath)NFProjectSystem.Default.props" Condition="Exists('$(NanoFrameworkProjectSystemPath)NFProjectSystem.Default.props')" />

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == ''">AnyCPU</Platform>
    <ProjectTypeGuids>{11A8DD76-328B-46DF-9F39-F559912D0360};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <ProjectGuid>{D6E4B1C2-3A4F-4B5C-9D12-3456789ABCDE}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <FileAlignment>512</FileAlignment>
    <RootNamespace>LED_Bar</RootNamespace>
    <AssemblyName>LED_Bar</AssemblyName>
    <TargetFrameworkVersion>v1.0</TargetFrameworkVersion>
  </PropertyGroup>

  <Import Project="$(NanoFrameworkLocalPath)NFProjectSystem.props" Condition="Exists('$(NanoFrameworkLocalPath)NFProjectSystem.props')" />
  <Import Project="$(NanoFrameworkProjectSystemPath)NFProjectSystem.props" Condition="Exists('$(NanoFrameworkProjectSystemPath)NFProjectSystem.props')" />

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="mscorlib">
      <HintPath>$(USERPROFILE)\.nuget\packages\nanoframework.corelibrary\1.17.11\lib\mscorlib.dll</HintPath>
    </Reference>
    <Reference Include="System.Drawing">
      <HintPath>$(USERPROFILE)\.nuget\packages\nanoframework.system.drawing\1.2.862\lib\System.Drawing.dll</HintPath>
    </Reference>
    <Reference Include="System.Device.Gpio">
      <HintPath>$(USERPROFILE)\.nuget\packages\nanoframework.system.device.gpio\1.1.57\lib\System.Device.Gpio.dll</HintPath>
    </Reference>
    <Reference Include="System.Device.Spi">
      <HintPath>$(USERPROFILE)\.nuget\packages\nanoframework.system.device.spi\1.3.82\lib\System.Device.Spi.dll</HintPath>
    </Reference>
    <Reference Include="nanoFramework.Hardware.Esp32">
      <HintPath>$(USERPROFILE)\.nuget\packages\nanoframework.hardware.esp32\1.6.37\lib\nanoFramework.Hardware.Esp32.dll</HintPath>
    </Reference>
    <Reference Include="nanoFramework.M5Core2">
      <HintPath>$(USERPROFILE)\.nuget\packages\nanoframework.m5core2\1.1.285\lib\nanoFramework.M5Core2.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Import Project="$(NanoFrameworkLocalPath)NFProjectSystem.CSharp.targets" Condition="Exists('$(NanoFrameworkLocalPath)NFProjectSystem.CSharp.targets')" />
  <Import Project="$(NanoFrameworkProjectSystemPath)NFProjectSystem.CSharp.targets" Condition="Exists('$(NanoFrameworkProjectSystemPath)NFProjectSystem.CSharp.targets')" />

  <ProjectExtensions>
    <ProjectCapabilities>
      <ProjectConfigurationsDeclaredAsItems/>
    </ProjectCapabilities>
  </ProjectExtensions>

</Project>
